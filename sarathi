<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Smart Farming Dashboard</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            display: flex;
            background: #f5f5f5;
        }

        /* Sidebar */
        .sidebar {
            width: 250px;
            height: 100vh;
            background: #0a5c36;
            color: white;
            padding: 20px;
        }

        .sidebar h2 {
            margin-bottom: 20px;
        }

        .sidebar ul {
            list-style: none;
        }

        .sidebar ul li {
            padding: 12px;
            margin: 10px 0;
            background: #0d6b3d;
            border-radius: 5px;
            cursor: pointer;
        }

        .sidebar ul li:hover {
            background: #12834c;
        }

        /* Main Content */
        .main {
            flex: 1;
            padding: 20px;
        }

        .header {
            background: green;
            color: white;
            padding: 15px;
            font-size: 22px;
            font-weight: bold;
            border-radius: 8px;
        }

        /* Cards */
        .cards {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-top: 20px;
        }

        .card {
            background: white;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
        }

        /* Form Section */
        .form-section {
            display: flex;
            gap: 20px;
            margin-top: 20px;
        }

        .form-box,
        .result-box {
            flex: 1;
            background: white;
            padding: 20px;
            border-radius: 10px;
        }

        input {
            width: 100%;
            padding: 10px;
            margin: 10px 0;
            border: 1px solid #ccc;
            border-radius: 5px;
        }

        button {
            padding: 10px 20px;
            background: green;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

        button:hover {
            background: darkgreen;
        }

        /* Result */
        .result {
            margin-top: 20px;
            padding: 20px;
            background: #dff5df;
            border-radius: 10px;
            text-align: center;
            font-size: 22px;
            font-weight: bold;
        }

        /* Table */
        table {
            width: 100%;
            margin-top: 20px;
            border-collapse: collapse;
            background: white;
        }

        table th,
        table td {
            padding: 12px;
            border: 1px solid #ddd;
            text-align: center;
        }

        table th {
            background: green;
            color: white;
        }

        /* Footer */
        .footer {
            text-align: center;
            margin-top: 20px;
            color: gray;
        }

        /* Responsive Fix */
        @media(max-width:768px) {
            body {
                flex-direction: column;
            }

            .sidebar {
                width: 100%;
                height: auto;
            }

            .cards {
                grid-template-columns: repeat(2, 1fr);
            }

            .form-section {
                flex-direction: column;
            }
        }
    </style>
</head>

<body>

    <div class="sidebar">
        <h2>Smart Farming</h2>
        <ul>
            <li>Dashboard</li>
            <li>Predict Crop</li>
            <li>Crop History</li>
            <li>Soil Data</li>
            <li>Manage Users</li>
            <li>Fertilizer Guide</li>
            <li>Weather Info</li>
            <li>Logout</li>
        </ul>
    </div>

    <div class="main">
        <div class="header">Welcome Back, Admin!</div>

        <div class="cards">
            <div class="card">Total Predictions <h2>25</h2>
            </div>
            <div class="card">Crops Predicted <h2>8</h2>
            </div>
            <div class="card">Users Registered <h2>12</h2>
            </div>
            <div class="card">Soil Records <h2>18</h2>
            </div>
        </div>

        <div class="form-section">
            <div class="form-box">
                <h3>Predict Crop</h3>

                <input type="number" id="nitrogen" placeholder="Nitrogen">
                <input type="number" id="phosphorus" placeholder="Phosphorus">
                <input type="number" id="potassium" placeholder="Potassium">
                <input type="number" id="temperature" placeholder="Temperature">
                <input type="number" id="humidity" placeholder="Humidity">
                <input type="number" id="phvalue" placeholder="pH Value">
                <input type="number" id="rainfall" placeholder="Rainfall">

                <button onclick="predictCrop()">Predict Crop</button>
            </div>

            <div class="result-box">
                <h3>Prediction Result</h3>
                <div class="result" id="result">
                    Recommended Crop: --
                </div>
            </div>
        </div>

        <table>
            <tr>
                <th>N</th>
                <th>P</th>
                <th>K</th>
                <th>Temperature</th>
                <th>Humidity</th>
                <th>pH</th>
                <th>Rainfall</th>
                <th>Crop</th>
            </tr>

            <tr>
                <td>90</td>
                <td>42</td>
                <td>43</td>
                <td>20.9</td>
                <td>82</td>
                <td>6.5</td>
                <td>202</td>
                <td>Rice</td>
            </tr>

            <tr>
                <td>85</td>
                <td>58</td>
                <td>41</td>
                <td>21.5</td>
                <td>80</td>
                <td>6.2</td>
                <td>226</td>
                <td>Wheat</td>
            </tr>
        </table>

        <div class="footer">
            © 2024 Smart Farming System. All rights reserved.
        </div>
    </div>

    <script>
        function predictCrop() {
            let temp = parseFloat(document.getElementById("temperature").value);
            let humidity = parseFloat(document.getElementById("humidity").value);
            let rainfall = parseFloat(document.getElementById("rainfall").value);

            let crop = "Unknown";

            if (temp >= 20 && humidity >= 80 && rainfall >= 200) {
                crop = "Rice";
            }
            else if (temp >= 15 && temp < 25 && rainfall < 200) {
                crop = "Wheat";
            }
            else if (temp >= 25 && humidity < 70) {
                crop = "Maize";
            }
            else {
                crop = "Cotton";
            }

            document.getElementById("result").innerHTML =
                "Recommended Crop: " + crop;
        }
    </script>

</body>

</html>
